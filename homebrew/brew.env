# Reduce `homebrew` auto-update interval to once every 8hrs.
HOMEBREW_AUTO_UPDATE_SECS=28800

#HOMEBREW_REQUIRE_TAP_TRUST=1
#HOMEBREW_NO_ENV_HINTS=1

# Forbid redirects from secure HTTPS to insecure HTTP. Note: while ensuring your
# downloads are fully secure, this is likely to cause sources for certain
# formulae hosted by SourceForge, GNU or GNOME to fail to download.
HOMEBREW_NO_INSECURE_REDIRECT=1

# Use bat for the brew cat command. Set $BAT_CONFIG_PATH to use a custom
# configuration file and $BAT_THEME to select a theme.
HOMEBREW_BAT=1
