#!/bin/bash -eu
#
# List GitHub pull requests, with the PR numbers as clickable links.
#
# Wraps `gh pr list`, whose normal output has no hyperlinks, and gh has no
# setting to add them. gh's `--template` formatter does expose a `hyperlink`
# function that emits OSC 8 escapes, so this reproduces gh's default table with
# the id linked to the pull request.
#
# Takes the same arguments as `gh pr list`.
#
# This is a script rather than a shell function because git runs its `!` aliases
# under /bin/sh, which cannot see one. See the `prs` aliases in config/git, and
# the `gh prs` alias in config/gh/config.yml -- both call this.

# `hyperlink` emits its escapes unconditionally, so anything that is not a
# terminal -- a pipe, a redirect -- needs gh's plain machine-readable output.
if [[ ! -t 1 ]]
then
    exec gh pr list "$@"
fi

# If the caller picked their own output format, or wants the browser or help,
# pass through to plain `gh pr list`.
for arg in "$@"
do
    case $arg in
        --json|--json=*|--jq|--jq=*|-q|-q=*|--template|--template=*|-t|-t=*|--web|-w|--help|-h)
            exec gh pr list "$@"
            ;;
    esac
done

# `--template` takes a Go text/template (https://pkg.go.dev/text/template),
# applied to the JSON that `--json` fetches -- here an array of pull requests.
# gh adds its own functions (`tablerow`, `tablerender`, `autocolor`, `timeago`,
# `hyperlink` and more) and a few from Sprig. `gh help formatting` lists them.
#
# shellcheck disable=SC2016  # the `$name` below is Go template, not shell.
template='
{{- if not . -}}
No pull requests match your search
{{ else -}}
{{- tablerow "ID" "TITLE" "BRANCH" "CREATED AT" -}}
{{- range . -}}
{{- /* gh shows a branch from a fork as owner:branch. */ -}}
{{- $branch := .headRefName -}}
{{- if and .isCrossRepository .headRepositoryOwner }}{{ $branch = printf "%s:%s" .headRepositoryOwner.login .headRefName }}{{ end -}}
{{- /* The id is colored by state, as gh colors it. */ -}}
{{- $color := "green" -}}
{{- if .isDraft }}{{ $color = "242" }}
{{- else if eq .state "MERGED" }}{{ $color = "magenta" }}
{{- else if eq .state "CLOSED" }}{{ $color = "red" }}{{ end -}}
{{- /* As in gh, the branch is cyan and the timestamp 242 (gray). */ -}}
{{- tablerow
      (hyperlink .url (autocolor $color (printf "#%v" .number)))
      .title
      (autocolor "cyan" $branch)
      (autocolor "242" (timeago .createdAt)) -}}
{{- end -}}
{{- /* tablerender prints the rows that tablerow buffered, fitting the columns
       to the terminal width and cutting long cells to fit ("..."). */ -}}
{{- tablerender -}}
{{- end -}}'

exec gh pr list \
    --json number,title,url,headRefName,createdAt,isCrossRepository,headRepositoryOwner,state,isDraft \
    --template "$template" \
    "$@"
