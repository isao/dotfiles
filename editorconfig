# <https://editorconfig.org/>
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
x-balance-while-typing = true
x-soft-wrap-mode = WindowWidth
x-soft-wrap-text = false
x-typographers-quotes = false

[{*.{markdown,md,mdx,rst,text,txt},CHANGELOG,README}]
x-soft-wrap-text = true

[*.{markdown,md,mdx,text}]
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4

[{tags,*.ctags}]
indent_style = tab

[{package.json,.travis.yml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 2
